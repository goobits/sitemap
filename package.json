{
	"name": "@goobits/sitemap",
	"version": "0.2.0",
	"description": "Reusable sitemap core, server helpers, and ops layer (search-engine pings + URL HEAD validation) for SvelteKit and any modern Fetch-API runtime",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./core": "./src/core.ts",
		"./server": "./src/server.ts",
		"./ops": "./src/ops.ts",
		"./sveltekit": "./src/sveltekit.ts",
		"./ui": "./src/ui.ts",
		"./ui/SitemapPage.svelte": "./src/ui/SitemapPage.svelte"
	},
	"keywords": [
		"sitemap",
		"sitemap.xml",
		"sveltekit",
		"svelte",
		"svelte-5",
		"seo",
		"search-engine",
		"indexnow",
		"xml",
		"esm"
	],
	"author": "Goobits",
	"license": "MIT",
	"homepage": "https://github.com/goobits/sitemap#readme",
	"bugs": "https://github.com/goobits/sitemap/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/goobits/sitemap.git"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.22.0",
	"peerDependencies": {
		"@lucide/svelte": "^1.26.0",
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0",
		"typescript": "^5.0.0 || ^6.0.0"
	},
	"peerDependenciesMeta": {
		"@lucide/svelte": {
			"optional": true
		},
		"@sveltejs/kit": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@lucide/svelte": "^1.26.0",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"jsdom": "^30.0.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"scripts": {
		"check": "pnpm run typecheck && pnpm run check:css && pnpm run test",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && svelte-check --workspace src/ui --fail-on-warnings",
		"check:css": "node scripts/checkCssConventions.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"clean": "rm -rf node_modules .turbo"
	}
}
